* { box-sizing: border-box; }
body {
  margin: 0;
  background: #0a0a0a;
  color: #e8e4da;
  font-family: system-ui, -apple-system, sans-serif;
}
button {
  background: #2a48f0;
  color: #fff;
  border: none;
  padding: 10px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 15px;
}
button:disabled { opacity: 0.5; cursor: not-allowed; }
input[type="file"] { color: #e8e4da; }

.spinner {
  width: 16px;
  height: 16px;
  border: 2px solid #333;
  border-top-color: #2a48f0;
  border-radius: 50%;
  display: inline-block;
  flex: none;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
